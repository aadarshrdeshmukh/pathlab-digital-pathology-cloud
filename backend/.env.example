# Server Configuration
PORT=5001
NODE_ENV=production

# Database Configuration (Option 1: Single Connection URI - recommended for Render/Railway/TiDB)
# DATABASE_URL=mysql://user:password@host:3306/pathlab_db?ssl={"rejectUnauthorized":false}

# Database Configuration (Option 2: Individual Connection Parameters)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
DB_NAME=pathlab_db
DB_PORT=3306
DB_SSL=true

# Security
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_SECRET

# CORS Configuration (comma-separated allowed origins or wildcard)
CORS_ORIGIN=http://localhost:3000,https://your-app.vercel.app

# AWS S3 Storage (Optional - falls back to local storage if unset)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_s3_bucket_name
